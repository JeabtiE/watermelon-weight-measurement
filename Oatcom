// ฟังก์ชันนี้ทำงานเมื่อกดปุ่ม Finish
// ใช้สำหรับสรุปผลการคัดแยกแตงโมทั้งหมด

void MainWindow::on_pushButton_finish_clicked()
{
    // หยุด timer ทั้งหมดของระบบ
    cameraTimer->stop();
    countdownTimer->stop();
    saveTimer->stop();

    // จำนวนแตงโมทั้งหมด
    int total = weights.size();

    // ถ้าไม่มีข้อมูล
    if(total == 0) return;

    // ตัวแปรรวมค่าน้ำหนัก
    double sum = 0;

    // รวมค่าน้ำหนักทั้งหมด
    for(double w : weights)
        sum += w;

    // คำนวณค่าเฉลี่ยน้ำหนัก
    double avgWeight = sum / total;

    ////////////////////////////////////////////////////////
    // คำนวณคะแนนเกรดเฉลี่ย
    ////////////////////////////////////////////////////////

    int gradeScore = 0;

    for(const QString &g : grades)
    {
        // แปลงเกรดเป็นคะแนน
        if(g == "A") gradeScore += 3;
        if(g == "B") gradeScore += 2;
        if(g == "C") gradeScore += 1;
    }

    // ค่าเฉลี่ยเกรด
    double avgGrade = (double)gradeScore / total;

    ////////////////////////////////////////////////////////
    // สร้างข้อความ dashboard
    ////////////////////////////////////////////////////////

    QString text;

    text += "===== DASHBOARD =====\n\n";

    text += "Total Watermelons : " + QString::number(total) + "\n";

    text += "Average Weight : " +
            QString::number(avgWeight,'f',2) + " kg\n";

    text += "Grade A : " + QString::number(countA) + "\n";
    text += "Grade B : " + QString::number(countB) + "\n";
    text += "Grade C : " + QString::number(countC) + "\n";

    // แสดงผล dashboard
    QMessageBox::information(this,"Dashboard",text);
}

