// ฟังก์ชัน export ข้อมูลใน tableWidget เป็นไฟล์ CSV
// ใช้สำหรับนำข้อมูลไปเปิดใน Excel / Google Sheets / Data analysis

void MainWindow::on_pushButton_export_clicked()
{
    // เปิด dialog ให้ผู้ใช้เลือกตำแหน่งและชื่อไฟล์
    QString fileName = QFileDialog::getSaveFileName(
        this,
        "Save Report",
        "",
        "CSV Files (*.csv)"
        );

    // ถ้าผู้ใช้กดยกเลิก
    if(fileName.isEmpty()) return;

    // สร้าง QFile object
    QFile file(fileName);

    // เปิดไฟล์สำหรับเขียนข้อความ
    if(!file.open(QIODevice::WriteOnly | QIODevice::Text))
        return;

    // QTextStream ใช้สำหรับเขียน text ลงไฟล์
    QTextStream out(&file);

    // จำนวน row และ column ของ table
    int rowCount = ui->tableWidget->rowCount();
    int colCount = ui->tableWidget->columnCount();

    /////////////////////////////////////////////////////////
    // เขียน header ของตาราง
    /////////////////////////////////////////////////////////

    for(int col=0; col<colCount; col++)
    {
        // ดึงชื่อ column header
        out << ui->tableWidget->horizontalHeaderItem(col)->text();

        // ใส่ comma เพื่อแบ่ง column
        if(col < colCount-1) out << ",";
    }

    // ขึ้นบรรทัดใหม่
    out << "\n";

    /////////////////////////////////////////////////////////
    // เขียนข้อมูลแต่ละ row
    /////////////////////////////////////////////////////////

    for(int row=0; row<rowCount; row++)
    {
        for(int col=0; col<colCount; col++)
        {
            // ดึง item จาก table
            QTableWidgetItem *item = ui->tableWidget->item(row,col);

            // ถ้ามีข้อมูล
            if(item) out << item->text();

            // คั่น column
            if(col < colCount-1) out << ",";
        }

        // ขึ้นบรรทัดใหม่เมื่อจบ row
        out << "\n";
    }

    // ปิดไฟล์
    file.close();

    // แจ้งเตือนผู้ใช้ว่า export สำเร็จ
    QMessageBox::information(this,"Success","Export Complete!");
}

