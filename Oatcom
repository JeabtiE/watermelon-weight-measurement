// ฟังก์ชันนี้ทำงานเมื่อกดปุ่ม Capture Calibration
// ใช้สำหรับ "ล็อกค่า Homography" หลังจากตรวจพบ ArUco marker ครบ 4 ตัว

void CalibrationWindow::on_btn_capture_clicked()
{
    // ถ้ายังไม่สามารถคำนวณ homography ได้
    if(!homography_ready)
    {
        // แจ้งเตือนผู้ใช้ว่า marker ยังไม่ครบ
        QMessageBox::warning(this,
                             "Calibration",
                             "Aruco markers not detected!");
        return;
    }

    // ตั้งค่าว่าระบบถูก calibration แล้ว
    calibrated = true;

    // debug message ใน console
    qDebug() << "Homography locked";

    // เปิดใช้งานปุ่ม continue
    // ผู้ใช้สามารถไปหน้าวัดแตงโมได้
    ui->btn_continue->setEnabled(true);
}

